# Backend only. Loaded from slotbook/.env, independent of the working directory.
SLOTBOOK_APP_NAME=SlotBook
SLOTBOOK_ENVIRONMENT=development
SLOTBOOK_LOG_LEVEL=INFO

# Vite server-side proxy target. Never put secrets in VITE_* variables.
API_PROXY_TARGET=http://127.0.0.1:8000

# Local development only; change both password values together if overriding.
POSTGRES_PASSWORD=slotbook_local_only
POSTGRES_PORT=5432
SLOTBOOK_DATABASE_URL=postgresql+psycopg://slotbook:slotbook_local_only@127.0.0.1:5432/slotbook
