# Backend only. Loaded from slotbook/.env, independent of the working directory.
SLOTBOOK_APP_NAME=SlotBook
SLOTBOOK_ENVIRONMENT=development
SLOTBOOK_LOG_LEVEL=INFO

# Vite server-side proxy target. Never put secrets in VITE_* variables.
API_PROXY_TARGET=http://127.0.0.1:8000

# Local development only; change both password values together if overriding.
POSTGRES_PASSWORD=slotbook_local_only
POSTGRES_PORT=5432
SLOTBOOK_DATABASE_URL=postgresql+psycopg://slotbook:slotbook_local_only@127.0.0.1:5432/slotbook

# Exact browser origin, no trailing slash. Production requires HTTPS.
SLOTBOOK_PUBLIC_ORIGIN=http://127.0.0.1:5173

# Optional in development; required in production. Local Redis: make db-up.
# SLOTBOOK_REDIS_URL=redis://127.0.0.1:6379/0
# SLOTBOOK_LOGIN_LIMIT=10
# SLOTBOOK_REGISTER_LIMIT=5
# SLOTBOOK_BOOKING_LIMIT=20
# SLOTBOOK_RATE_WINDOW_SECONDS=60

# Background notifications (optional local processes; outbox events are always persisted).
# SLOTBOOK_BROKER_URL=amqp://slotbook:slotbook_local_only@127.0.0.1:5672//
# SLOTBOOK_EMAIL_URL=http://127.0.0.1:8001/messages
# SLOTBOOK_EMAIL_API_KEY=
# SLOTBOOK_NOTIFICATION_MAX_ATTEMPTS=5

# Optional AI search; disabled until model+key are set. Requires Redis.
# SLOTBOOK_AI_MODEL=gpt-4.1-mini
# SLOTBOOK_AI_API_KEY=
# SLOTBOOK_AI_URL=https://api.openai.com/v1/chat/completions
# SLOTBOOK_AI_TIMEOUT_SECONDS=8
# SLOTBOOK_AI_DAILY_REQUEST_LIMIT=100
# SLOTBOOK_AI_LIMIT=5
