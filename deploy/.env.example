POSTGRES_PASSWORD=replace-with-a-long-random-password
SLOTBOOK_DATABASE_URL=postgresql+psycopg://slotbook:replace-with-a-long-random-password@db:5432/slotbook
SLOTBOOK_PUBLIC_ORIGIN=https://slotbook.example.com
HTTP_PORT=8080
IMAGE_TAG=local
# Shared by every API process. Redis remains inside the Compose network.
SLOTBOOK_REDIS_URL=redis://redis:6379/0
SLOTBOOK_LOGIN_LIMIT=10
SLOTBOOK_BOOKING_LIMIT=20
SLOTBOOK_RATE_WINDOW_SECONDS=60
SLOTBOOK_RATE_PREFIX=slotbook:rate:v1
