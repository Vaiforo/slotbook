    "/api/v1/specialists/{slug}/slots": {
      "get": {
        "operationId": "get_available_slots",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "description": "Inclusive start; ISO 8601 with UTC offset. Range at most 31 days.",
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "description": "Inclusive start; ISO 8601 with UTC offset. Range at most 31 days.",
              "format": "date-time",
              "title": "From",
              "type": "string"
            }
          },
          {
            "description": "Exclusive start-time bound; ISO 8601 with UTC offset.",
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "description": "Exclusive start-time bound; ISO 8601 with UTC offset.",
              "format": "date-time",
              "title": "To",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 10000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotPage"
